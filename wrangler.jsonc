// ui.simon-lund.com: the registry (static/r/<item>.json, the URLs `shadcn-svelte add` takes) and
// the book, one page per component, as a SvelteKit app on a Worker. Public: no gate.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "simon-lund-ui",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "ui.simon-lund.com", "custom_domain": true }],
	"observability": { "enabled": true }
}
