{
	"name": "registry",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.0.5",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm registry && vite build",
		"preview": "wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"registry": "node -e \"fs.rmSync('static/r', { recursive: true, force: true })\" && node scripts/build-registry-json.js && shadcn-svelte registry build"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260101.0",
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^24.19.2",
		"shadcn-svelte": "^1.7.0",
		"shiki": "^4.6.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.151.0"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@lucide/svelte": "^1.70.0",
		"@number-flow/svelte": "^0.4.2",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"embla-carousel": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2"
	}
}
